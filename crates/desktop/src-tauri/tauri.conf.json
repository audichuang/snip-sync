{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "snip-sync",
	"version": "0.1.2",
	"identifier": "com.audichuang.snip-sync",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "snip-sync",
				"width": 1000,
				"height": 720,
				"minWidth": 480,
				"minHeight": 400,
				"visible": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
