{
	"name": "snip-sync",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "node ./node_modules/@typescript/native/bin/tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"start": "tauri dev",
		"generate:dto": "cargo test --manifest-path src-tauri/Cargo.toml --lib export_dto -- --ignored",
		"typecheck": "node ./node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit && node ./node_modules/@typescript/native/bin/tsc -p tsconfig.node.json --noEmit --composite false --incremental false"
	},
	"dependencies": {
		"@heroui/react": "^3.2.5",
		"@heroui/styles": "^3.2.5",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-dialog": "^2.7.3",
		"@tauri-apps/plugin-log": "^2.9.1",
		"react": "19.2.7",
		"react-dom": "19.2.7"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.11.4",
		"@types/node": "^25.9.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitejs/plugin-react": "^6.1.1",
		"tailwindcss": "^4.3.3",
		"vite": "^8.3.0"
	}
}
